# ==============================================================================
# AMR Assistant - Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your values.
# NEVER commit your actual '.env' file to Git!

# ------------------------------------------------------------------------------
# Google AI Studio Configuration (Free Tier)
# Get your free key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Model name for Live Bidirectional Audio
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Model voice (Options: Puck, Charon, Kore, Fenrir, Aoede)
GEMINI_VOICE_NAME=Aoede

# ------------------------------------------------------------------------------
# Wake Word & Audio Engine Settings
# ------------------------------------------------------------------------------
AMR_WAKE_WORD=aton

# Audio input/output device index (leave blank for Windows default devices)
AUDIO_INPUT_DEVICE_INDEX=
AUDIO_OUTPUT_DEVICE_INDEX=

# Sample rate (standard for Gemini Live is 16000 or 24000 Hz)
AUDIO_SAMPLE_RATE=16000

# Continuous conversation silence timeout (in seconds before AMR goes to sleep)
CONVERSATION_TIMEOUT_SECONDS=7

# ------------------------------------------------------------------------------
# Smart TV & Local Network (Phase 2)
# ------------------------------------------------------------------------------
# IP address of your Smart TV on Wi-Fi (optional, leave blank for auto-discovery)
SMART_TV_IP=
# Brand: auto, samsung, lg, android_tv
SMART_TV_BRAND=auto
# MAC address for Wake-on-LAN to turn TV on (e.g. AA:BB:CC:DD:EE:FF)
SMART_TV_MAC=

# ------------------------------------------------------------------------------
# Android Phone Finder & Smart Lights (Phase 2)
# ------------------------------------------------------------------------------
# Local Wi-Fi IP address of your Android phone (for MacroDroid, Tasker or ADB)
ANDROID_PHONE_IP=
ANDROID_PHONE_PORT=8080

# Local IP address of Smart Lights bridge/hub (Philips Hue, Tuya, Tasmota, Sonoff)
SMART_LIGHTS_BRIDGE_IP=

# ------------------------------------------------------------------------------
# Mobile Gateway & Tailscale Remote Access (Phase 3)
# ------------------------------------------------------------------------------
# Enable background HTTP gateway for mobile/car access
GATEWAY_ENABLED=true
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8443
# Optional security token for remote access (leave blank for open within private Tailscale VPN)
GATEWAY_API_TOKEN=

# ------------------------------------------------------------------------------
# Google Workspace & Calendar (Phase 4)
# ------------------------------------------------------------------------------
# Path to OAuth 2.0 Client Credentials JSON from Google Cloud Console (Desktop App)
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials.json
# Path to stored OAuth 2.0 user tokens (auto-generated on first authentication)
GOOGLE_CALENDAR_TOKEN_PATH=token.json
# Directory for protected multi-account calendar tokens
GOOGLE_CALENDAR_TOKENS_DIR=tokens
# Optional default account email when using multiple Google Calendar accounts
GOOGLE_CALENDAR_DEFAULT_ACCOUNT=
# Primary calendar ID (defaults to 'primary' for user's main Google Calendar)
GOOGLE_CALENDAR_ID=primary
# User timezone (defaults to 'America/Fortaleza')
GOOGLE_CALENDAR_TIMEZONE=America/Fortaleza

# Path to Gmail credentials (shares credentials.json and token.json by default)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Path to Google Tasks credentials (shares credentials.json and token.json by default)
GOOGLE_TASKS_CREDENTIALS_PATH=credentials.json
GOOGLE_TASKS_TOKEN_PATH=token.json
GOOGLE_TASKS_DEFAULT_LIST=@default

# ------------------------------------------------------------------------------
# Long-Term Semantic Memory (Phase 5 Local Fallback)
# ------------------------------------------------------------------------------
# Local SQLite database file for user preferences and facts
MEMORY_DB_PATH=amr_memory.db

# ------------------------------------------------------------------------------
# Second Brain - Supabase Cloud, pgvector & Edge Functions (Online Architecture)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co
# Supabase Anon Public Key (client read-only / authenticated user)
SUPABASE_KEY=your_supabase_anon_key_here
# Supabase Service Role Secret Key (NEVER share or commit to git)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# System Tray & Background Resident (Phase 6)
# ------------------------------------------------------------------------------
# Enable resident Windows taskbar tray icon with status feedback and quick actions
SYSTEM_TRAY_ENABLED=true

# ------------------------------------------------------------------------------
# System & Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

# Fire TV Stick: IP local e caminho absoluto do ADB
FIRE_TV_IP=
FIRE_TV_ADB_PATH=

# Multi-LLM fase zero: politica offline, sem conectores ativos.
MULTI_LLM_ENABLED=false

# Groq: configurar localmente, nunca enviar a chave pelo chat.
GROQ_API_KEY=
GROQ_FREE_PLAN_VERIFIED=false
GROQ_ENABLED=true
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=15

# OpenRouter: NVIDIA Nemotron e modelos de planejamento (Custo Zero com :free)
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=true
OPENROUTER_MODEL=nvidia/llama-3.1-nemotron-70b-instruct:free
OPENROUTER_TIMEOUT_SECONDS=25

# NVIDIA NIM Oficial (build.nvidia.com) - Direto com clusters H100 (1.000 créditos grátis)
NVIDIA_API_KEY=
NVIDIA_ENABLED=true
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
